# =======================================================
# Étude Math Pro — Configuration Variables d'Environnement
# =======================================================

# Port d'écoute du serveur (Défaut: 8000)
PORT=8000

# Clé secrète pour signature des jetons JWT (Changez cette valeur en production !)
SECRET_KEY=math-prof-secret-super-key-2026-production-change-me

# Base de données
# 1. SQLite Local (Laissez vide pour utiliser automatiquement backend/data/math_prof.db)
# DATABASE_URL=

# 2. PostgreSQL Cloud (Render, Supabase, Neon, Railway, Docker)
# Exemple Supabase : DATABASE_URL=postgresql://postgres.xxxx:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Exemple Render   : DATABASE_URL=postgresql://mathprof_user:password@dpg-xxxx-a.frankfurt-postgres.render.com/mathprof_db
DATABASE_URL=

# Environnement (production / development)
ENVIRONMENT=production
