*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.spec
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing & Caches
.pytest_cache/
.coverage
htmlcov/
