*.sqlite-journal
*.db-journal
backend/data/*.db
backend/data/*.sqlite*

# Logs
logs/
*.log

# Generated Reports & PDFs
reports/
backend/reports/
backend/data/reports/
*.pdf

# Operating System & IDE
.DS_Store
Thumbs.db
